# Copy to web/.env.local (gitignored). CI writes .env.production from repo Secrets.

# Firebase web app config (Firebase console → Project settings → Your apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your-project>
VITE_FIREBASE_STORAGE_BUCKET=<your-project>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public web app URL, TMDB REST base, guest TMDB proxy path (Hosting rewrite to tmdbProxy)
VITE_WEB_BASE_URL=https://<your-site>.web.app
VITE_TMDB_API_BASE=https://api.themoviedb.org/3
VITE_TMDB_PROXY_BASE=/api/tmdb

# Optional: reCAPTCHA v3 site key registered with App Check
VITE_RECAPTCHA_SITE_KEY=

# Mixpanel project token + host (EU projects: https://api-eu.mixpanel.com). Empty token → no tracking
VITE_MIXPANEL_TOKEN=
VITE_MIXPANEL_SERVER_URL=

# Dev server only: use the local Emulator Suite
# VITE_USE_EMULATORS=true
