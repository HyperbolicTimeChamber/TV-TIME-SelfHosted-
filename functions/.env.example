# Copy to functions/.env.<your-firebase-project-id> (gitignored). `firebase deploy` loads it only
# for that project; scripts load it too. Every key is optional unless noted; code defaults are safe.

# Required. Guest TMDB proxy: browsers allowed to call it (comma-separated origins)
TMDB_PROXY_ALLOWED_ORIGINS=https://<your-site>.web.app,https://<your-site>.firebaseapp.com,http://localhost:5173
# Required. Share link previews (Open Graph) — sharePreview function
WEB_BASE_URL=https://<your-site>.web.app
# Mixpanel project token + host (EU projects: https://api-eu.mixpanel.com). Empty token → no tracking
MIXPANEL_TOKEN=
MIXPANEL_SERVER_URL=

# --- Flags (code defaults in brackets) ---
# Guest TMDB proxy: reject requests without App Check — only once the web ships VITE_RECAPTCHA_SITE_KEY [false]
TMDB_PROXY_ENFORCE_APP_CHECK=false
# Requests/second to TMDB (TMDB allows ~40) [35]
TMDB_PROXY_RATE_LIMIT=35
# Share link preview tagline [Track What You Watch]
SHARE_TAGLINE=Track What You Watch
# Callables: reject requests without App Check — only once the App Check app build is widespread [false]
ENFORCE_CALLABLE_APP_CHECK=false
# budgetGuard: true → unlink billing when the "billing-budget" budget's cost reaches its amount [false]
BILLING_KILL_SWITCH=false

# Emulator Suite: also create functions/.env.local (gitignored, emulator-only) with
#   MIXPANEL_TOKEN=
# so emulated runs don't report into production Mixpanel
