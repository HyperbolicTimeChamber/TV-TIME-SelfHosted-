# Cloud Functions params (non-secret; deployed with the functions)
# Guest TMDB proxy: browsers allowed to call it (first filter; App Check is the real lock)
TMDB_PROXY_ALLOWED_ORIGINS=https://watchloom-app.web.app,https://watchloom-app.firebaseapp.com,http://localhost:5173
# Set true once the web app ships an App Check (reCAPTCHA v3) site key
TMDB_PROXY_ENFORCE_APP_CHECK=false
# Requests/second to TMDB (TMDB allows ~40)
TMDB_PROXY_RATE_LIMIT=35
# Share link previews (Open Graph) — sharePreview function
WEB_BASE_URL=https://watchloom-app.web.app
SHARE_TAGLINE=Track What You Watch
# Callables: reject requests without App Check. Flip to true only once the app build with App Check is what people run
ENFORCE_CALLABLE_APP_CHECK=false
# budgetGuard: true → unlink billing when the "billing-budget" budget's cost reaches its amount (stops the project's paid usage)
BILLING_KILL_SWITCH=true
