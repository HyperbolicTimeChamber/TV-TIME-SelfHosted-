rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Write validation ────────────────────────────────────────────────
    // Clients may only add/change the fields they really write (removing a field is fine —
    // historyAt uses deleteField(), and a full set() may drop server-written fields).
    // Stops a signed-in script from stuffing arbitrary or huge data into its own docs.
    // Cloud Functions use the Admin SDK and skip these rules.

    function before() {
      return resource == null ? {} : resource.data;
    }

    function writtenKeys() {
      let d = request.resource.data.diff(before());
      return d.addedKeys().union(d.changedKeys());
    }

    function onlyWrites(allowed) {
      return writtenKeys().hasOnly(allowed);
    }

    // Absent, null, or a string up to max chars (TMDB titles are far shorter)
    function optString(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function optNumber(field) {
      return !(field in request.resource.data) || request.resource.data[field] is number;
    }

    function optTimestamp(field) {
      return !(field in request.resource.data) || request.resource.data[field] is timestamp;
    }

    // { season, episode } pointer, or null
    function optEpisodeRef(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is map
            && request.resource.data[field].keys().hasOnly(['season', 'episode'])
            && request.resource.data[field].get('season', 0) is number
            && request.resource.data[field].get('episode', 0) is number);
    }

    // users/{uid}.stats: only the four client counters change, always numbers
    function validStats() {
      let after = request.resource.data.get('stats', {});
      let prev = before().get('stats', {});
      let d = after.diff(prev);
      return after is map
        && d.addedKeys().union(d.changedKeys())
            .hasOnly(['showsTracking', 'episodesWatched', 'moviesWatched', 'totalMinutes'])
        && after.get('showsTracking', 0) is number
        && after.get('episodesWatched', 0) is number
        && after.get('moviesWatched', 0) is number
        && after.get('totalMinutes', 0) is number;
    }

    function validUserDoc() {
      return onlyWrites(['stats', 'lastAppOpen', 'hideUnreleasedMovieModal'])
        && (!('stats' in writtenKeys()) || validStats())
        && optTimestamp('lastAppOpen')
        && (!('hideUnreleasedMovieModal' in request.resource.data)
            || request.resource.data.hideUnreleasedMovieModal is bool);
    }

    function validTracking(showId) {
      return showId.matches('^(tv|movie)_[0-9]{1,10}$')
        && onlyWrites([
          'tmdbId', 'mediaType', 'status', 'nextEpisode', 'nextEpisodeName',
          'nextEpisodeAirDate', 'rewatchCount', 'addedAt', 'lastWatchedAt', 'priorityDate',
          'releaseDate', 'title', 'posterPath', 'lastEpisode', 'historyAt',
          'historyUpdatedAt', 'minutesWatched', 'plays'
        ])
        && optNumber('tmdbId')
        && (!('mediaType' in request.resource.data)
            || request.resource.data.mediaType in ['tv', 'movie'])
        && (!('status' in request.resource.data)
            || request.resource.data.status in
                ['watching', 'plan_to_watch', 'completed', 'paused', 'rewatching', 'paused_rewatch'])
        && optEpisodeRef('nextEpisode')
        && optEpisodeRef('lastEpisode')
        && optString('nextEpisodeName', 1000)
        && optString('nextEpisodeAirDate', 40)
        && optString('releaseDate', 40)
        && optString('title', 1000)
        && optString('posterPath', 300)
        && optNumber('rewatchCount')
        && optNumber('minutesWatched')
        && optNumber('plays')
        && optTimestamp('addedAt')
        && optTimestamp('lastWatchedAt')
        && optTimestamp('priorityDate')
        && optTimestamp('historyAt')
        && optTimestamp('historyUpdatedAt');
    }

    function validWatchedEpisode(episodeId) {
      return episodeId.matches('^[0-9]{1,10}_S[0-9]{2,4}E[0-9]{2,5}$')
        && onlyWrites([
          'tmdbShowId', 'season', 'episode', 'episodeTitle', 'runtime', 'watchCount',
          'lastWatchedAt', 'watchedAt'
        ])
        && optNumber('tmdbShowId')
        && optNumber('season')
        && optNumber('episode')
        && optString('episodeTitle', 1000)
        && optNumber('runtime')
        && optNumber('watchCount')
        && optTimestamp('lastWatchedAt')
        && optTimestamp('watchedAt');
    }

    function validWatchedMovie(movieId) {
      return movieId.matches('^[0-9]{1,10}$')
        && onlyWrites(['tmdbId', 'runtime', 'watchCount', 'lastWatchedAt'])
        && optNumber('tmdbId')
        && optNumber('runtime')
        && optNumber('watchCount')
        && optTimestamp('lastWatchedAt');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Paths ────────────────────────────────────────────────────────────

    // App config — read-only for authenticated users
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Shared catalog — read for authenticated; trackedBy is maintained by addShow / removeShow
    match /shows/{showId} {
      allow read: if request.auth != null;
      allow write: if false; // CF-only

      match /trackedByOverflow/{chunk} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Per-user data — owner only, validated shapes
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserDoc();
      allow delete: if false; // purgeUserData (CF)

      match /tracking/{showId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTracking(showId);
      }

      match /watchedEpisodes/{episodeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validWatchedEpisode(episodeId);
      }

      match /watchedMovies/{movieId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validWatchedMovie(movieId);
      }

      // Custom lists — a bookmark list only; never touches tracking. Caps mirror CUSTOM_LIST_* in enums
      match /customLists/{listId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'items', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 500;
      }

      match /upcoming/{episodeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false; // CF-only writes
      }
    }
  }
}
