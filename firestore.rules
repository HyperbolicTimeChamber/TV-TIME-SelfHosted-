rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App config — read-only for authenticated users
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Shared catalog — read for authenticated, scoped trackedBy update only
    match /shows/{showId} {
      allow read: if request.auth != null;
      allow create: if false; // CF-only
      allow delete: if false; // CF-only
      allow update: if request.auth != null
        // Only trackedBy and trackedByCount can be modified
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['trackedBy', 'trackedByCount'])
        // User can only add their own UID to trackedBy
        && request.resource.data.trackedBy.hasAll(resource.data.trackedBy)
        && request.resource.data.trackedBy.size() <= resource.data.trackedBy.size() + 1
        && request.auth.uid in request.resource.data.trackedBy;

      match /trackedByOverflow/{chunk} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Per-user data — owner only
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      match /tracking/{showId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /watchedEpisodes/{episodeId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /watchedMovies/{movieId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /upcoming/{episodeId} {
        allow read: if request.auth.uid == userId;
        allow write: if false; // CF-only writes
      }
    }
  }
}
