# Copy to app/.env (gitignored). EXPO_PUBLIC_* is inlined at build time; CI writes this file
# from repo Secrets. Project-specific values only live here — a fork fills in its own.

# Google OAuth Web Client ID (Google Cloud Console → APIs & Services → Credentials)
EXPO_PUBLIC_WEB_CLIENT_ID=
# Public web app: share links + App Links domain (app.config.js reads its host)
EXPO_PUBLIC_WEB_BASE_URL=https://<your-site>.web.app
# TMDB REST API base
EXPO_PUBLIC_TMDB_API_BASE=https://api.themoviedb.org/3

# Mixpanel project token + host (EU projects: https://api-eu.mixpanel.com). Empty token → no tracking
EXPO_PUBLIC_MIXPANEL_TOKEN=
EXPO_PUBLIC_MIXPANEL_SERVER_URL=

# CI only: build channel (dev / prod) and the testers' update link
# EXPO_PUBLIC_RELEASE_CHANNEL=
# EXPO_PUBLIC_UPDATE_URL=

# Dev builds only: use the local Emulator Suite / App Check debug token
# EXPO_PUBLIC_USE_EMULATORS=true
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
