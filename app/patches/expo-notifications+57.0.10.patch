+  // PATCH(watchloom): `source` center-cropped to w x h with rounded corners
+  private fun roundedThumb(source: Bitmap, w: Int, h: Int, radius: Float): Bitmap {
+    val out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+    val canvas = Canvas(out)
+    val paint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+    val scale = max(w.toFloat() / source.width, h.toFloat() / source.height)
+    val sw = source.width * scale
+    val sh = source.height * scale
+    val matrix = android.graphics.Matrix().apply {
+      setScale(scale, scale)
+      postTranslate((w - sw) / 2, (h - sh) / 2)
+    }
+    paint.shader = android.graphics.BitmapShader(source, android.graphics.Shader.TileMode.CLAMP, android.graphics.Shader.TileMode.CLAMP).apply {
+      setLocalMatrix(matrix)
+    }
+    canvas.drawRoundRect(RectF(0f, 0f, w.toFloat(), h.toFloat()), radius, radius, paint)
+    return out
+  }
+
+  // PATCH(watchloom): the picture center-cropped to 2:1 (max 1024 wide), the title logo centred above the
+  // caption rows, which sit on a dark fade along the bottom
+  private fun composePicture(source: Bitmap, logo: Bitmap?, caption: List<String>): Bitmap {
+    val w = min(source.width, 1024)
+    val h = w / 2
+    val out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+    val canvas = Canvas(out)
+    val paint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+    val scale = max(w.toFloat() / source.width, h.toFloat() / source.height)
+    val bw = source.width * scale
+    val bh = source.height * scale
+    canvas.drawBitmap(source, null, RectF((w - bw) / 2, (h - bh) / 2, (w + bw) / 2, (h + bh) / 2), paint)
+    if (logo != null || caption.isNotEmpty()) canvas.drawColor(0x40000000)
+
+    val mainSize = h * 0.095f
+    val subSize = h * 0.07f
+    val gap = h * 0.025f
+    val bottomPad = h * 0.07f
+    var captionHeight = 0f
+    caption.forEachIndexed { i, _ -> captionHeight += (if (i == 0) mainSize else subSize) + (if (i > 0) gap else 0f) }
+    if (caption.isNotEmpty()) {
+      val fadeTop = h - captionHeight - bottomPad * 2.5f
+      val fade = Paint().apply {
+        shader = android.graphics.LinearGradient(
+          0f, fadeTop, 0f, h.toFloat(), 0x00000000, 0xCC000000.toInt(), android.graphics.Shader.TileMode.CLAMP
+        )
+      }
+      canvas.drawRect(0f, fadeTop, w.toFloat(), h.toFloat(), fade)
+    }
+
+    // Logo in the space above the caption
+    val logoArea = h - (if (caption.isNotEmpty()) captionHeight + bottomPad * 1.6f else 0f)
+    if (logo != null && logo.width > 0 && logo.height > 0) {
+      val s = min(w * 0.55f / logo.width, logoArea * 0.62f / logo.height)
+      val lw = logo.width * s
+      val lh = logo.height * s
+      val top = (logoArea - lh) / 2 + (if (caption.isNotEmpty()) h * 0.03f else 0f)
+      canvas.drawBitmap(logo, null, RectF((w - lw) / 2, top, (w + lw) / 2, top + lh), paint)
+    }
+
+    // Caption rows, bottom-centred: the first bold and larger
+    var y = h - bottomPad - captionHeight
+    caption.forEachIndexed { i, text ->
+      val size = if (i == 0) mainSize else subSize
+      val tp = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = if (i == 0) 0xFFFFFFFF.toInt() else 0xDDFFFFFF.toInt()
+        textSize = size
+        textAlign = Paint.Align.CENTER
+        typeface = android.graphics.Typeface.create(android.graphics.Typeface.DEFAULT, if (i == 0) android.graphics.Typeface.BOLD else android.graphics.Typeface.NORMAL)
+        setShadowLayer(size * 0.15f, 0f, size * 0.05f, 0x99000000.toInt())
+        letterSpacing = if (i == 0) 0.04f else 0.02f
+      }
+      if (i > 0) y += gap
+      y += size
+      val fitted = android.text.TextUtils.ellipsize(text, android.text.TextPaint(tp), w * 0.88f, android.text.TextUtils.TruncateAt.END).toString()
+      canvas.drawText(fitted, w / 2f, y - size * 0.18f, tp)
+    }
+    return out
+  }
