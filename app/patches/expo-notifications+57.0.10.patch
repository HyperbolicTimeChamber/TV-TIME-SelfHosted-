+  // PATCH(watchloom): rich styles for airing alerts; false → the default BigText style
+  private suspend fun applyWatchloomStyle(builder: NotificationCompat.Builder, content: INotificationContent): Boolean {
+    val data = content.body ?: return false
+    // The picture first; offline at fire time → the episode list, else plain text
+    val pictureUrl = data.optString("bigPicture", "")
+    val backdrop = if (pictureUrl.isNotEmpty()) downloadImage(Uri.parse(pictureUrl)) else null
+    if (backdrop != null) {
+      val logoUrl = data.optString("bigPictureLogo", "")
+      val logo = if (logoUrl.isNotEmpty()) downloadImage(Uri.parse(logoUrl)) else null
+      val caption = data.optString("bigPictureCaption", "").split("\n").filter { it.isNotBlank() }
+      val picture = composePicture(backdrop, logo, caption)
+      // Custom views inside the system frame: the header keeps the app icon on the left on every
+      // Android version (a large icon moves there on Android 16), the thumbnail sits on the right
+      val density = context.resources.displayMetrics.density
+      // Circular thumbnail: a square crop with a radius of half its side
+      val side = (40 * density).toInt()
+      val thumb = roundedThumb(backdrop, side, side, side / 2f)
+      val collapsed = RemoteViews(context.packageName, R.layout.watchloom_alert_collapsed).apply {
+        setTextViewText(R.id.watchloom_title, content.title)
+        setTextViewText(R.id.watchloom_text, content.text)
+        setImageViewBitmap(R.id.watchloom_thumb, thumb)
+      }
+      // Expanded: just the picture when the episode is drawn on it; else the body above it
+      val expanded = RemoteViews(context.packageName, R.layout.watchloom_alert_expanded).apply {
+        setTextViewText(R.id.watchloom_title, content.title)
+        setTextViewText(R.id.watchloom_text, content.text)
+        if (caption.isNotEmpty()) setViewVisibility(R.id.watchloom_text, android.view.View.GONE)
+        // The title row holds the heading ("Airing today"); without one it's hidden — the logo names the title
+        val heading = data.optString("bigPictureHeading", "")
+        if (heading.isNotEmpty()) setTextViewText(R.id.watchloom_title, heading)
+        else setViewVisibility(R.id.watchloom_title, android.view.View.GONE)
+        setImageViewBitmap(R.id.watchloom_picture, roundedThumb(picture, picture.width, picture.height, picture.width * 0.025f))
+      }
+      builder.setCustomContentView(collapsed)
+      builder.setCustomHeadsUpContentView(collapsed)
+      builder.setCustomBigContentView(expanded)
+      builder.setStyle(NotificationCompat.DecoratedCustomViewStyle())
+      return true
+    }
+    val lines = data.optString("lines", "")
+    if (lines.isNotEmpty()) {
+      val list = runCatching { JSONArray(lines) }.getOrNull()
+      if (list != null && list.length() > 0) {
+        val style = NotificationCompat.InboxStyle().setBigContentTitle(content.title)
+        for (i in 0 until list.length()) style.addLine(list.optString(i))
+        builder.setStyle(style)
+        return true
+      }
+    }
+    return false
+  }
